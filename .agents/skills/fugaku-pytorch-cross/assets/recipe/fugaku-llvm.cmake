set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /opt/FJSVxos/devkit/aarch64/rfs)
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(FUGAKU_LLVM /vol0004/apps/r/OSS_CN/llvm-22.1.0)
set(FUGAKU_FJ /opt/FJSVxtclanga/tcsds-1.2.43)
set(CMAKE_C_COMPILER ${FUGAKU_LLVM}/cross_clangfx/clang-comp/bin/clang)
set(CMAKE_CXX_COMPILER ${FUGAKU_LLVM}/cross_clangfx/clang-comp/bin/clang++)
get_filename_component(PYCROSS_ROOT "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(CMAKE_FIND_ROOT_PATH "${PYCROSS_ROOT}/target;${CMAKE_SYSROOT};${FUGAKU_FJ}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=a64fx -msve-vector-bits=512 -DOMPI_SKIP_MPICXX=1")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=a64fx -msve-vector-bits=512 -DOMPI_SKIP_MPICXX=1 -D_GLIBCXX_USE_CXX11_ABI=1")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-Wl,-rpath,${FUGAKU_FJ}/lib64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath,${FUGAKU_FJ}/lib64")
set(MPI_C_COMPILER ${FUGAKU_LLVM}/fj-mpi/cross_mpi/bin/mpiclang CACHE FILEPATH "")
set(MPI_CXX_COMPILER ${FUGAKU_LLVM}/fj-mpi/cross_mpi/bin/mpiclang++ CACHE FILEPATH "")
set(MPI_CXX_SKIP_MPICXX ON CACHE BOOL "")
# FindMPI's compile/link probes succeed, but its rooted find_path cannot
# rediscover wrapper headers outside the sysroot without these explicit paths.
set(MPI_C_HEADER_DIR ${FUGAKU_LLVM}/fj-mpi/cross_mpi/include/mpi/fujitsu CACHE PATH "" FORCE)
set(MPI_CXX_HEADER_DIR ${FUGAKU_LLVM}/fj-mpi/cross_mpi/include/mpi/fujitsu CACHE PATH "" FORCE)
# Pass OpenMP lowering to cc1 without asking the driver to add LLVM libomp.
# The header symlink is created by build.sh; Fujitsu's runtime serves the ABI.
foreach(lang C CXX)
  set(OpenMP_${lang}_FLAGS "-Xclang -fopenmp -I${PYCROSS_ROOT}/omp-include" CACHE STRING "")
  set(OpenMP_${lang}_LIB_NAMES fjomp CACHE STRING "")
endforeach()
set(OpenMP_fjomp_LIBRARY ${FUGAKU_FJ}/lib64/libfjomp.so CACHE FILEPATH "")
