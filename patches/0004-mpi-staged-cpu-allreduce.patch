 // Checking CUDA-aware MPI support, currently we only support CUDA aware
 // MPI ops through Open MPI
+// Without large pages, Fujitsu MPI registers every new buffer it sends with
+// the interconnect, seconds per step at 48 ranks; staging CPU reductions
+// through one reused buffer registers it once. Opt in: TORCH_MPI_STAGE_BYTES.
+size_t mpiStageBytes() {
+  static const size_t bytes = [] {
+    const char* v = std::getenv("TORCH_MPI_STAGE_BYTES");
+    return v ? static_cast<size_t>(std::strtoull(v, nullptr, 10)) : size_t{0};
+  }();
+  return bytes;
+}
+
+// Called with pgGlobalMutex_ held, so one buffer serves the process.
+char* mpiStageBuffer(size_t bytes) {
+  static char* buf = [bytes] {
+    void* p = nullptr;
+    return posix_memalign(&p, size_t{1} << 21, bytes) == 0 ? static_cast<char*>(p) : nullptr;
+  }();
+  return buf;
+}
